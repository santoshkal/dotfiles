command=$SCRIPT_DIR/$BLOCK_NAME
separator_block_width=15
markup=none

[volume]
label=
command=$SCRIPT_DIR/volume/volume
color=#219897
interval=once
signal=10

[memory]
label=
color=#219897
command=$SCRIPT_DIR/memory/memory
separator=false
interval=30

[memory]
label=
command=$SCRIPT_DIR/memory2/memory2
color=#219897
instance=swap
separator=false
interval=30

[disk]
label=
color=#219897
command=$SCRIPT_DIR/disk/disk
interval=30

[wifi]
color=#219897
label=
interval=10
command=$SCRIPT_DIR/wifi/wifi
separator=false

[bandwidth]
color=#219897
label=
interval=5
command=$SCRIPT_DIR/bandwidth/bandwidth

[cpu_usage]
label=
color=#219897
command=$SCRIPT_DIR/cpu_usage/cpu_usage
interval=10
min_width=CPU 100.00%

[load_average]
label=
color=#219897
command=$SCRIPT_DIR/memory/load_average/load_average
interval=10

[battery]
label=
color=#219897
command=$SCRIPT_DIR/battery/battery
interval=30

[time]
color=#219897
label=
command=date '+%Y-%m-%d %H:%M:%S'
interval=5
