#!/bin/bash
set -eux

sudo() {
  if [ "$(id -u)" -eq 0 ]; then
    "$@"
  else
    command sudo "$@"
  fi
}

{{ if .is_arch -}}
# Install packages on Arch
packages=(
  neovim
  tmux
  ripgrep
  fd
  fzf
  bat
  eza
  lazygit
  kubectl
  helm
  eksctl
  aws-cli-v2
  go
  nodejs
  npm
  python
  python-pip
  pyenv
  docker
  docker-compose
  kitty
  i3
  i3blocks
  yazi
  ghostty
)

yay -S --noconfirm --needed "${packages[@]}"

{{ else if .is_ubuntu -}}
# Install packages on Ubuntu
# Note: some packages have different names on Ubuntu
sudo apt update
sudo env DEBIAN_FRONTEND=noninteractive apt install --yes \
  neovim \
  tmux \
  ripgrep \
  fd-find \
  fzf \
  bat \
  git \
  curl \
  wget \
  unzip \
  kubectl \
  helm \
  golang-go \
  nodejs \
  npm \
  python3 \
  python3-pip \
  docker.io \
  docker-compose

# eza not in Ubuntu default repos - install via cargo if available
if command -v cargo >/dev/null 2>&1; then
  cargo install --locked eza 2>/dev/null || true
else
  echo "Note: eza not installed (cargo not available). Install manually if needed."
fi

# Create symlinks for Ubuntu package name differences
if command -v fdfind >/dev/null 2>&1 && ! command -v fd >/dev/null 2>&1; then
  sudo ln -sf "$(command -v fdfind)" /usr/local/bin/fd 2>/dev/null || true
fi

if command -v batcat >/dev/null 2>&1 && ! command -v bat >/dev/null 2>&1; then
  sudo ln -sf "$(command -v batcat)" /usr/local/bin/bat 2>/dev/null || true
fi

{{ end -}}