#!/bin/bash
set -eux

# Set default shell to zsh if not already (skip in containers/CI)
# Skip if zsh is not installed
zsh_path=$(command -v zsh) || {
  echo "zsh is not installed"
  exit 1
}

# Get the configured login shell
current_shell=$(getent passwd "$(id -un)" | cut -d: -f7)

# Change only if necessary
if [ "$current_shell" != "$zsh_path" ]; then
  if [ -n "${CI:-}" ] || [ -n "${DEVCONTAINER:-}" ] || [ "$(id -u)" -eq 0 ]; then
    echo "Skipping chsh in container/CI/root environment"
  else
    echo "Changing login shell to zsh..."
    chsh -s "$zsh_path"
  fi
fi
